{
  "name": "zidooka-cli",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "post": "node src/index.js",
    "remote:agent": "node scripts/remote-agent/index.js",
    "ga4": "node scripts/ga4-report.mjs",
    "gsc": "node scripts/gsc-query.mjs",
    "seo:followup": "node scripts/seo-followup-report.mjs",
    "ga4:admin-setup": "node scripts/ga4-admin-setup.mjs",
    "seo:weekly": "node scripts/ga4-report.mjs --period 7d && node scripts/gsc-query.mjs --period 7d",
    "seo:monthly": "node scripts/ga4-report.mjs --period 30d && node scripts/gsc-query.mjs --period 30d",
    "seo:errors": "node scripts/seo-followup-report.mjs --query-limit 3",
    "adsense": "node scripts/adsense-report.mjs",
    "ads:check": "node scripts/check-a8-links.mjs",
    "bing": "node scripts/bing-webmaster-report.mjs",
    "weekly": "node scripts/weekly-report.mjs",
    "indexnow": "node scripts/ping-indexnow.mjs",
    "posthog:check": "node scripts/posthog-check.mjs",
    "posthog:status": "node -e \"const fs=require('fs');const p=require('path');const f=p.join(process.cwd(),'drat','posthog-status.md');if(fs.existsSync(f))console.log(fs.readFileSync(f,'utf8'));else console.log('No status file. Run npm run posthog:check first.')\"",
    "backup:content": "node scripts/backup-content.mjs",
    "improve": "node scripts/self-improvement-loop.mjs",
    "improve:report": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'daily','self-improvement');const f=fs.readdirSync(d).filter(x=>x.endsWith('.md')).sort().pop();console.log(f?fs.readFileSync(p.join(d,f),'utf8'):'No reports found.')\"",
    "decisions": "node scripts/check-decisions.mjs",
    "theme:audit": "node scripts/theme-visual-audit.mjs"
  },
  "dependencies": {
    "agent-browser": "github:vercel-labs/agent-browser",
    "axios": "^1.6.2",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.3.1",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3",
    "marked": "^11.1.0",
    "openai": "^4.24.1",
    "playwright": "^1.57.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^10.0.3",
    "webdav": "^4.11.3"
  }
}
